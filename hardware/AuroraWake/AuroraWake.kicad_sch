	(text "* Module OLED 0,96\" SSD1306 128x64 I2C, adresse 0x3C (SA0=0), alimente en 3,3 V (~20 mA, 30 mA tout blanc)." (exclude_from_sim no) (at 430.5 413.92 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "b8befc8b-7e2f-5760-89b2-a8130a7140b9"))
	(text "* Brochage du connecteur J701 : GND - VCC - SCL - SDA. ATTENTION : certains modules sont en VCC - GND :" (exclude_from_sim no) (at 430.5 418.12 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "b04d9d52-6612-5efc-b6a3-fcba48c1a279"))
	(text "  verifier le module achete avant de souder (inversion = module detruit)." (exclude_from_sim no) (at 430.5 422.32 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "593089c9-9376-529e-84ad-c938316b7156"))
	(text "* Les modules embarquent souvent des pull-up 4,7k/10k : en parallele avec R602/R603 => ~2,3 k, acceptable." (exclude_from_sim no) (at 430.5 426.52 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "2169c4a1-582e-5760-84c4-1d63f4803039"))
	(text "* Alternative plus lisible la nuit : SH1106 1,3\" (meme brochage, adresse 0x3C, driver different)." (exclude_from_sim no) (at 430.5 430.72 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "4474777e-68dd-52c6-98a6-30b3b4749f0f"))
	(text "* Pour un reveil : prevoir dans le firmware une luminosite (contraste) minimale la nuit et un mode veille ecran." (exclude_from_sim no) (at 430.5 434.92 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "c5fb6c4a-275e-536f-b475-445585ab8f91"))
