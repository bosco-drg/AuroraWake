	(text "AUDIO - choix et risques" (exclude_from_sim no) (at 633.25 199.58 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "0fec7af8-037a-5511-ae68-ec5da0681944"))
	(text "* U401 MAX98357A : classe D I2S, 3,2 W / 4 Ohm sous 5 V, sans filtre LC (filterless)." (exclude_from_sim no) (at 633.25 203.78 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "75ad7e8b-db1e-501a-a52f-4d7ab9232f7e"))
	(text "* FB401 + C401..C403 : 5 V audio isole du 5 V logique (ferrite), decouplage 10uF+100nF+100uF au plus pres." (exclude_from_sim no) (at 633.25 207.98 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "37d3675c-366d-5154-9c96-0382e7040f5a"))
	(text "* GAIN_SLOT a GND = 12 dB. ~SD_MODE pilote par GPIO via 10k (pull-down interne 100k) :" (exclude_from_sim no) (at 633.25 212.18 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "a59a8163-859f-55c7-ba5e-855a0df861e7"))
	(text "  GPIO=0 -> arret (aussi pendant le boot), GPIO=1 -> ~3 V => canal GAUCHE (le firmware envoie le son sur L)." (exclude_from_sim no) (at 633.25 216.38 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "60db95ed-7e01-5938-b4af-b421568d5a25"))
	(text "* FB402/FB403 + C404/C405 : filtre CEM pour fils de HP > 10 cm." (exclude_from_sim no) (at 633.25 220.58 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "bd14329c-0c5d-50c2-a067-74a279fd9c7c"))
	(text "* Masse : l'ampli reste sur GND (ses entrees I2S y sont referencees) mais dans une zone dediee ;" (exclude_from_sim no) (at 633.25 224.78 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "01759a04-f645-5f0c-abf8-64f841b82386"))
	(text "  les courants de sortie bouclent localement HP <-> ampli <-> C403 et ne traversent pas la zone ESP32." (exclude_from_sim no) (at 633.25 228.98 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "db3bd071-425f-5e27-aec5-d39c8514938d"))
	(text "* Buzzer passif BZ401 (secours si SD absente/illisible), Q401 AO3400A + D401 roue libre, PWM ~2,7 kHz." (exclude_from_sim no) (at 633.25 233.18 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "65db12de-fe3a-5716-8ada-5e7fd62b21be"))
