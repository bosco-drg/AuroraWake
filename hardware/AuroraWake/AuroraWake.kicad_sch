	(text "PANNEAU LED - choix et risques" (exclude_from_sim no) (at 430.5 137.18 0) (effects (font (size 1.8 1.8)) (justify left bottom)) (uuid "ffa3a683-16ef-5560-92e1-f57a32516241"))
	(text "* Commutation bas-cote : Q301 AOD4184A (40 V, ~9 mOhm @ Vgs 4,5 V) en TO-252 -> ~0,2 W a 4,2 A." (exclude_from_sim no) (at 430.5 141.38 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "88545b01-cd5a-5058-b160-7bc54b6f2363"))
	(text "* Le GPIO 3,3 V ne suffit pas a saturer un MOSFET de puissance : driver U301 UCC27511A alimente en 5 V" (exclude_from_sim no) (at 430.5 145.58 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "6332c442-61a9-5597-9943-709beaba3b1c"))
	(text "  (Vgs = 5 V, toujours < 20 V meme si le 12 V monte a 24 V ; entrees TTL compatibles 3,3 V)." (exclude_from_sim no) (at 430.5 149.78 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "35537e81-f560-5264-90bf-998a52622312"))
	(text "* R301 10 Ohm (montee) / R302 4,7 Ohm (descente) : fronts maitrises -> CEM. R303 10k : grille a 0 si driver non alimente." (exclude_from_sim no) (at 430.5 153.98 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "26b4fc5e-5ec8-5edc-b917-5514554f84ef"))
	(text "* R304 100k : LED_PWM tire a 0 pendant le boot de l'ESP32 => panneau eteint au demarrage." (exclude_from_sim no) (at 430.5 158.18 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "4bd00b06-0e99-579c-a084-8405a4a97772"))
	(text "* D301 SS54 : roue libre sur l'inductance du cable du panneau. C303/C304 : reservoir local pour les fronts PWM." (exclude_from_sim no) (at 430.5 162.38 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "ea3a0759-d11a-5bcb-9b50-4cd8b2badb7e"))
	(text "* PWM recommandee : 20-25 kHz (inaudible), LEDC 11 bits ; pertes de commutation ~25 mW." (exclude_from_sim no) (at 430.5 166.58 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "f184e584-2647-51ff-8890-7671df0b3bc6"))
	(text "* TOUT ce circuit est sur PGND : boucle 12V -> J301 -> Q301 -> PGND -> J101 sans traverser le plan GND logique." (exclude_from_sim no) (at 430.5 170.78 0) (effects (font (size 1.4 1.4)) (justify left bottom)) (uuid "c9e1b37a-b213-5040-bfa2-741af5c807a7"))
